# ---- Host tooling ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- C++ / CMake ----
build/
cmake-build-*/
compile_commands.json
*.o
*.a
*.so
!third_party/librknnrt.so
!third_party/onnxruntime/lib/**

# ---- Runtime scratch ----
*.wav
*.log
run.log
dumps/
uploads/

# ---- Models / data (never in git) ----
models/
data/
**/espeak-data/
**/espeak-ng-data/

# ---- Upstream / generated ----
Kokoro-82M/
kokoro-src/
voices_npy/
onnx/
*.onnx
*.rknn
norm_stats.npz

# ---- Build-time deps (host install trees; Docker context via .dockerignore exceptions) ----
deps/drogon-src/
deps/drogon-install/
deps/opusenc-src/
deps/opusenc-install/

# ---- Leftover staging / vendored runtime dumps ----
docker/stage/
third_party/lib/
third_party/espeak-data/

# Keep only docker/apt.conf if present
docker/*
!docker/apt.conf

.antigravitycli
.env
.env.*
!.env.example
