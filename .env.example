# docker compose loads variables from .env

# Host directory with Kokoro HF clone (mounted as /models in the container):
KOKORO_MODELS_DIR=

# Auto-download ru packs from Hugging Face on container start:
KOKORO_DOWNLOAD_MODELS=ru

# Default voice (sveta, masha, dima)
KOKORO_DEFAULT_VOICE=sveta

# HTTP port on the host (default 8848). Prefer: docker compose up -d --wait
PORT=8848

# Optional bearer token for API requests
# KOKORO_TOKEN=sk-your-secret

# Disable demo web UI (API only)
# KOKORO_DISABLE_WEB_UI=1

# Custom file URLs (optional):
# KOKORO_MODEL_URLS=packs/base/config.json=https://example.com/config.json

# On host:
#   http://127.0.0.1:8848/          web UI
#   http://127.0.0.1:8848/health
#   http://127.0.0.1:8848/api/v1/synthesise
